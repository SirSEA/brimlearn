# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Session signing key ───────────────────────────────────────────────────────
# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ── Google sign-in (Sign in with Google) ─────────────────────────────────────
# Create an "OAuth 2.0 Client ID" (type: Web application) at
# https://console.cloud.google.com/apis/credentials and paste the two values.
# Add the callback to "Authorized redirect URIs":
#   http://localhost:3000/api/oauth/google/callback    (local development)
#   https://<your-host>/api/oauth/google/callback      (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Firebase / Cloud Firestore ────────────────────────────────────────────────
# Choose ONE of the three options below:
#
#  (a) Path to the service-account JSON (local only — it is git-ignored, so it
#      will NOT be available on managed hosts):
#      FIREBASE_SERVICE_ACCOUNT_PATH=./brimlearn-app-firebase-adminsdk-fbsvc-f615102eac.json
#
#  (b) The three credential fields directly (best for managed hosts). The
#      private key is multi-line; put it on one line with literal \n escapes:
#      FIREBASE_PROJECT_ID=
#      FIREBASE_CLIENT_EMAIL=
#      FIREBASE_PRIVATE_KEY=
#
#  (c) Application Default Credentials on the host:
#      GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Scopes session tokens to a specific app id. Only set this if you deploy the
# same codebase for multiple tenants.
# VITE_APP_ID=