# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Session signing key ───────────────────────────────────────────────────────
# Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ── Admin account (created by: npm run db:seed) ───────────────────────────────
# Sign in at /admin/login (a dedicated admin route, separate from the public
# sign-in page). ADMIN_PASSWORD must be at least 8 characters.
# ADMIN_NAME=BrimLearn Admin
ADMIN_EMAIL=admin@brimlearn.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Workspace owner OpenID. Users with this OpenID always keep the admin role and
# can never be demoted from the admin console. Find a user's OpenID in the
# Firestore "users" collection (doc id), or leave blank to skip owner protection.
# OWNER_OPEN_ID=email_asdf...xyz

# ── Quiz & assessment AI ──────────────────────────────────────────────────────
# API key for the LLM used to generate practice quizzes and assessments. When
# this is blank the quiz generator falls back to safe, canned questions — useful
# for testing but not for production.
# BUILT_IN_FORGE_API_KEY=
# Optional custom OpenAI-compatible base URL (defaults to the hosted endpoint).
# BUILT_IN_FORGE_API_URL=

# ── Google sign-in (Sign in with Google) ─────────────────────────────────────
# Create an "OAuth 2.0 Client ID" (type: Web application) at
# https://console.cloud.google.com/apis/credentials and paste the two values.
# Add the callback to "Authorized redirect URIs":
#   http://localhost:3000/api/oauth/google/callback    (local development)
#   https://<your-host>/api/oauth/google/callback      (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Firebase / Cloud Firestore ────────────────────────────────────────────────
# Choose ONE of the three options below:
#
#  (a) Path to the service-account JSON (local only — it is git-ignored, so it
#      will NOT be available on managed hosts):
#      FIREBASE_SERVICE_ACCOUNT_PATH=./brimlearn-app-firebase-adminsdk-fbsvc-f615102eac.json
#
#  (b) The three credential fields directly (best for managed hosts). Paste the
#      private key value EXACTLY as it appears in the service-account JSON —
#      including the literal \n characters and WITHOUT surrounding quotes, e.g.:
#      FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
#      The server tolerates most manglings (quotes, real newlines, or the whole
#      JSON), but NOT a truncated key.
#      FIREBASE_PROJECT_ID=
#      FIREBASE_CLIENT_EMAIL=
#      FIREBASE_PRIVATE_KEY=
#
#  (c) Application Default Credentials on the host:
#      GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Transactional email (password resets) ─────────────────────────────────────
# Leave blank to run in "demo mode": the forgot-password flow generates a reset
# link and shows it in the browser so everything is testable today for free.
# When you have a domain + mail server (or a free SMTP trial like Mailgun/SendGrid
# sandbox / Resend), install the optional transport and set these:
#
#   npm i nodemailer
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# SMTP_FROM="BrimLearn <no-reply@example.com>"
#
# How long a reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=30

# ── Optional ──────────────────────────────────────────────────────────────────
# Scopes session tokens to a specific app id. Only set this if you deploy the
# same codebase for multiple tenants.
# VITE_APP_ID=

# ── Jitsi live classroom (production) ─────────────────────────────────────────
# Today the app uses the free public meet.jit.si service (no config needed).
# When you're ready for moderation/recording controls, self-host Jitsi Meet on
# a VPS and enable token-based access here. See docs/jitsi-live-classroom-production.md
# for the full wiring checklist.
#
# JITSI_DOMAIN is the meet server the iframe loads from.
#   Dev / trial  : meet.jit.si                       (public, no JWT possible)
#   Production   : meet.example.com                  (self-hosted, JWT supported)
JITSI_DOMAIN=meet.jit.si
#
# JWT moderation signs a per-session token so the teacher is granted the
# "moderator" role (lock room, mute all, kick) and learners join as guests.
# Requires JITSI_DOMAIN to be your OWN self-hosted Jitsi server — the public
# meet.jit.si service does not accept third-party app secrets.
JITSI_JWT_MODERATION=false
#
# The Jitsi "JWT security" app credentials. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Add these (JWT accepted / "Token Auth") to the Prosody + jitsi-meet config on
# your Jitsi server (jitsi-meet.example.com/app-id and shared-secret).
JITSI_APP_ID=
JITSI_APP_SECRET=
#
# Room prefix used when deriving the Jitsi room name from a session id
# (must match the room name rules; defaults to "brimlearn-")
# JITSI_ROOM_PREFIX=brimlearn-